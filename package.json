{
    "name": "document-context-workspace",
    "private": true,
    "version": "0.0.2-20261105.a",
    "description": "Monorepo for @sandlada/document-context (v0.1 layered architecture).",
    "author": "Kai Orion",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sandlada/document-context.git"
    },
    "homepage": "https://github.com/sandlada/document-context#readme",
    "type": "module",
    "packageManager": "pnpm@12.14.0",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "build": "pnpm --filter @sandlada/document-context build",
        "test": "pnpm --filter @sandlada/document-context test",
        "test:watch": "pnpm --filter @sandlada/document-context test:watch",
        "test:browser": "pnpm --filter @sandlada/document-context test:browser",
        "test:e2e:browser": "pnpm --filter @sandlada/document-context test:e2e:browser",
        "typecheck": "pnpm --filter @sandlada/document-context typecheck",
        "typecheck:build": "pnpm --filter @sandlada/document-context typecheck:build",
        "typecheck:test": "pnpm --filter @sandlada/document-context typecheck:test",
        "site:dev": "pnpm --filter site dev",
        "site:build": "pnpm --filter site build",
        "site:preview": "pnpm --filter site preview",
        "site:sync": "pnpm --filter site sync",
        "site:check": "pnpm --filter site check",
        "site:verify": "pnpm --filter site verify"
    },
    "engines": {
        "node": ">=22.12.0",
        "pnpm": ">=12.14.0"
    },
    "devDependencies": {
        "only-allow": "^1.2.1"
    }
}
