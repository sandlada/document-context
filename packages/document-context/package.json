{
    "name": "@sandlada/document-context",
    "version": "0.1.0-alpha.0",
    "description": "Function-first, DOM-hosted IoC container and reactive state library (next generation, layered architecture).",
    "author": "Kai Orion",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sandlada/document-context.git",
        "directory": "packages/document-context"
    },
    "homepage": "https://github.com/sandlada/document-context#readme",
    "keywords": [
        "document-context",
        "ioc",
        "inversion-of-control",
        "dependency-injection",
        "state-management",
        "reactive",
        "rxjs",
        "w3c-context-protocol",
        "web-components",
        "micro-frontends",
        "functional",
        "curried"
    ],
    "type": "module",
    "sideEffects": false,
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js",
            "default": "./build/index.js"
        },
        "./domain": {
            "types": "./build/domain/index.d.ts",
            "import": "./build/domain/index.js",
            "default": "./build/domain/index.js"
        },
        "./application": {
            "types": "./build/application/index.d.ts",
            "import": "./build/application/index.js",
            "default": "./build/application/index.js"
        },
        "./infrastructure/dom": {
            "types": "./build/infrastructure/dom/index.d.ts",
            "import": "./build/infrastructure/dom/index.js",
            "default": "./build/infrastructure/dom/index.js"
        },
        "./infrastructure/storage": {
            "types": "./build/infrastructure/storage/index.d.ts",
            "import": "./build/infrastructure/storage/index.js",
            "default": "./build/infrastructure/storage/index.js"
        },
        "./infrastructure/ssr": {
            "types": "./build/infrastructure/ssr/index.d.ts",
            "import": "./build/infrastructure/ssr/index.js",
            "default": "./build/infrastructure/ssr/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest run",
        "test:watch": "vitest",
        "bench": "vitest bench --run bench",
        "typecheck": "tsc --noEmit",
        "typecheck:build": "tsc --project tsconfig.build.json --noEmit",
        "typecheck:test": "tsc --project tsconfig.test.json --noEmit"
    },
    "peerDependencies": {
        "rxjs": "^7.8.0 || ^8.0.0"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.11",
        "happy-dom": "^20.11.6",
        "rxjs": "^7.8.2",
        "tinybench": "^2.9.0",
        "tsdown": "^0.22.14",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
